# Copy to .env and fill in. Used by compose.yml.

# The panel's domain; its DNS must point at this machine for HTTPS.
GAMEPANEL_DOMAIN=panel.example.com

# Pin a release (e.g. v0.1.0) instead of following the newest one.
GAMEPANEL_VERSION=latest

# off, admins or all
GAMEPANEL_REQUIRE_MFA=admins

# From Nodes -> Create node; needed only for `docker compose --profile node up`.
GAMEPANEL_NODE_TOKEN=
