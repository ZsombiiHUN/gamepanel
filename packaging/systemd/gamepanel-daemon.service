# GamePanel daemon (a node). Installed by scripts/install.sh; see docs/nodes/installing.md.
# Runs as root: it hands server folders to uid 1000, talks to Docker, and
# enters container network namespaces for bandwidth limits.
[Unit]
Description=GamePanel daemon
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/gamepanel/daemon.env
ExecStart=/usr/local/bin/gamepanel-daemon
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
